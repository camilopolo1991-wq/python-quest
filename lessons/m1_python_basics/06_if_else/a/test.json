    "title": "Adult check",
    "task": [
      "Ask the age with int(input(\"Age: \")).",
      "Print Adult if 18 or more, otherwise Minor."
    ],
    "hints": [
      "18 should say Adult. Is that > or >= ?"
    ],
    "tests": [
      {
        "label": "20 → Adult",
        "inputs": [
