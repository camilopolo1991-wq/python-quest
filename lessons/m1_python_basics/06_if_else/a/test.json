        ],
        "not_contains": [
          "Minor"
        ]
      },
      {
        "label": "15 → Minor",
        "inputs": [
          "15"
        ],
        "contains": [
          "Minor"
        ],
        "not_contains": [
          "Adult"
        ]
      },
      {
        "label": "18 → Adult",
        "inputs": [
          "18"
        ],
        "contains": [
          "Adult"
        ],
        "not_contains": [
          "Minor"
        ]
      }
    ]
  },
