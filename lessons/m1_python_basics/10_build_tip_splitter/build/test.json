{
  "id": "m1-10",
  "title": "Build: Tip Splitter",
  "task": [
    "Read lessons/m1_python_basics/10_build_tip_splitter/README.md",
    "Write your program in build.py"
  ],
  "file": "build.py",
  "hints": [
    "Start by writing the 3 input() lines.",
    "Tip money = bill * tip / 100",
    "f\"{each:.2f}\" always shows 2 decimals."
  ],
  "tests": [
    {
      "label": "300000, 4, 10% → 82500.00 + Expensive night!",
      "inputs": [
        "300000",
        "4",
        "10"
      ],
      "contains": [
        "Each pays: 82500.00",
        "Expensive night!"
      ]
    },
    {
      "label": "100000, 3, 0% → 33333.33",
      "inputs": [
        "100000",
        "3",
        "0"
      ],
      "contains": [
        "Each pays: 33333.33"
      ],
      "not_contains": [
        "Expensive"
      ]
    },
    {
      "label": "90000, 2, 15% → 51750.00 + Expensive night!",
      "inputs": [
        "90000",
        "2",
        "15"
      ],
      "contains": [
        "Each pays: 51750.00",
        "Expensive night!"
      ]
    }
  ],
  "build": true
}
